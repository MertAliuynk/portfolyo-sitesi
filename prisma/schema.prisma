// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Project {
    id          String   @id @default(cuid())
    slug        String   @unique
    title       String
    summary     String
    description String
    tags        String
    gradient    String
    liveUrl     String?
    repoUrl     String?
    year        Int
    featured    Boolean  @default(false)
    order       Int      @default(0)
    /// case-study details, edited from the admin panel
    role        String?
    duration    String?
    status      String?
    coverImage  String?
    /// rich case study body (TipTap JSON)
    contentJson String?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @default(now()) @updatedAt

    @@index([slug])
}

model Post {
    id          String   @id @default(cuid())
    slug        String   @unique
    title       String
    excerpt     String
    /// legacy markdown body; posts written in the admin editor use contentJson
    content     String   @default("")
    /// TipTap JSON document
    contentJson String?
    /// "markdown" for seeded posts, "rich" for editor posts
    format      String   @default("markdown")
    coverImage  String?
    tag         String
    readingTime Int
    /// search: overrides "<title> — <name>" in the browser tab and Google
    seoTitle       String?
    /// search: the snippet under the link; falls back to the excerpt
    seoDescription String?
    /// the phrase this post should be found for, checked in the editor
    focusKeyword   String?
    /// tutorial difficulty: "baslangic" | "orta" | "ileri"
    level          String?
    published   Boolean  @default(true)
    publishedAt DateTime @default(now())
    createdAt   DateTime @default(now())
    updatedAt   DateTime @default(now()) @updatedAt

    @@index([slug])
}

/// One visit: a visitor's continuous stay on the site (a new one starts after
/// 30 minutes of silence). Filled by /api/t, read in /admin/ziyaretciler.
model VisitSession {
    id          String       @id
    /// random id kept in the visitor's browser, so returning visitors are recognised
    visitorId   String
    ip          String?
    userAgent   String?
    browser     String?
    os          String?
    /// "Mobil" | "Tablet" | "Masaüstü"
    device      String?
    country     String?
    region      String?
    city        String?
    isp         String?
    referrer    String?
    utmSource   String?
    language    String?
    screen      String?
    landingPath String
    pageviews   Int          @default(0)
    clicks      Int          @default(0)
    startedAt   DateTime     @default(now())
    lastSeenAt  DateTime     @default(now())
    events      VisitEvent[]

    @@index([startedAt])
    @@index([lastSeenAt])
    @@index([visitorId])
}

/// Something a visitor did: opened a page, clicked, scrolled.
model VisitEvent {
    id        String       @id @default(cuid())
    sessionId String
    session   VisitSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    /// "pageview" | "click" | "scroll"
    type      String
    path      String
    /// page title for pageviews, the visible text for clicks
    label     String?
    /// where a clicked link pointed
    target    String?
    /// scroll depth in percent
    value     Int?
    at        DateTime     @default(now())

    @@index([sessionId, at])
    @@index([type, at])
}
